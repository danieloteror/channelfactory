# Copia a .env (fuera de Git). Solo nombres de variables; nunca pegues secretos en chats, logs o commits.

# Investigación de referencias (YouTube Data API v3)
YOUTUBE_API_KEY=

# Proveedores opcionales (bloqueados si budget.paid_providers_enabled=false)
ANTHROPIC_API_KEY=
BFL_API_KEY=
ELEVENLABS_API_KEY=

# Modelos locales (por defecto ~/.cache/channel_factory/models)
CHANNEL_FACTORY_MODELS_DIR=

# --- Metricool (DESACTIVADO por defecto; ver docs/metricool.md) ---
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
# Almacenamiento público persistente para los medios que Metricool descarga
CF_S3_BUCKET=
CF_S3_PUBLIC_BASE_URL=
CF_S3_ENDPOINT=
CF_SUPABASE_URL=
CF_SUPABASE_SERVICE_KEY=
CF_SUPABASE_BUCKET=
